# bin/cron/ のcronジョブが必要とする最小の環境変数。cron_run.sh が source する
# (set -a 下でsourceするので、ここでの代入は全てexportされる)。
#
# ここはbash構文ファイル。crontab の env代入行とは違い $HOME 等が展開される。
# マシン固有の上書き(ロケール等)が要る場合だけ bin/cron/_cron.env (gitignore) を作る。
#
# PATH: cronの最小PATHの代わり。$HOME/bin と、cronジョブが名前で呼ぶツールのある
# サブディレクトリを明示的に列挙する(PATHは再帰しないため)。ジョブを足してそれが
# 別ドメインのツールを名前で呼ぶなら、そのディレクトリをここへ追加する。
# (対話シェルのPATHは .bashrc が組み立てているが、.bashrc はマシン固有・gitignoreの
#  ため参照しない。cronジョブが必要とするPATHはこのファイルで明示宣言する。)

PATH=$HOME/bin:$HOME/bin/cron:$HOME/bin/due_watch:$HOME/bin/gcal:$HOME/bin/freee:$HOME/bin/worklog/tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

TZ=Asia/Tokyo

# ロケール: ジョブがロケール依存の出力に依存しないよう、universalなC.UTF-8を既定にする。
# 日本語ロケールが要るジョブが出たら _cron.env で上書き。
LANG=C.UTF-8
LC_ALL=C.UTF-8
