# Cloudflare Access service token for cloudflare_access_ssh_proxy.sh.
# Copy to .env, fill in, and run: chmod 600 .env
# Zero Trust dashboard: Access > Service auth > Service Tokens > Create Service Token.
# The secret is shown only once at creation time.
# Use a separate token per machine (home, office) so one can be revoked alone.
CF_ACCESS_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.access"
CF_ACCESS_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
