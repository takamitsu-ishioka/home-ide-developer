# Copy this file to .env, set mode 600, and replace NTFY_TOPIC manually.
#
# On the public ntfy.sh server the topic name IS the password: anyone who
# knows it can read every notification sent to it and can send you fake
# ones. So the name must stay unguessable.
#
# Give it a readable prefix so you can tell channels apart in the phone app,
# and append a random part for secrecy:
#
#   echo "codex-turn-$(openssl rand -hex 20)"
#
# Keep the prefix; replace only the hex part with your own generated value.
# Changing the topic means re-subscribing in the ntfy app on the phone.
NTFY_SERVER="https://ntfy.sh"
NTFY_TOPIC="codex-turn-replace-this-with-40-hex-characters"
NTFY_TITLE="作業通知"
NTFY_PRIORITY="default"
